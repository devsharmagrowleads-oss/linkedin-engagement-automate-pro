# Session time windows (HH:MM-HH:MM)
MORNING_WINDOW=08:00-10:00
AFTERNOON_WINDOW=12:00-14:00
EVENING_WINDOW=17:00-19:00

# Daily reaction target range
DAILY_TARGET_MIN=45
DAILY_TARGET_MAX=55

# Max jitter delay in minutes before starting a session
MAX_JITTER_MINUTES=30

# Max session duration in minutes
MAX_SESSION_MINUTES=25

# Timezone (match your actual timezone)
TIMEZONE=Asia/Kolkata

# Browser viewport
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
