# Account name (for multi-account setups — leave empty for single account)
# Each account gets its own browser profile, database, and lockfile.
# Example: ACCOUNT=john or ACCOUNT=client-acme
ACCOUNT=

# Session time windows (HH:MM-HH:MM)
MORNING_WINDOW=08:00-10:00
AFTERNOON_WINDOW=12:00-14:00
EVENING_WINDOW=17:00-19:00

# Daily reaction target range (0 min allows natural zero-reaction days)
DAILY_TARGET_MIN=0
DAILY_TARGET_MAX=45

# Reaction pacing (seconds between reactions — key anti-detection lever)
# Higher = safer. 60-180s mimics real human browsing speed.
REACTION_DELAY_MIN_SEC=60
REACTION_DELAY_MAX_SEC=180

# Keyword match skip percentage (skip 60-80% of matches to look selective)
MATCH_SKIP_MIN=60
MATCH_SKIP_MAX=80

# Typing speed range (ms per character, 40-90 is natural typing speed)
TYPING_SPEED_MIN=40
TYPING_SPEED_MAX=90

# New account ramp-up (gradually increase activity over first 4 weeks)
ENABLE_RAMP_UP=true

# Max jitter delay in minutes before starting a session
MAX_JITTER_MINUTES=30

# Max session duration in minutes
MAX_SESSION_MINUTES=25

# Timezone (must be valid IANA identifier, e.g. America/New_York, Europe/London)
TIMEZONE=Asia/Kolkata

# Browser locale (should match timezone region)
LOCALE=en-IN

# Browser viewport
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768

# Anti-detection: probability of skipping an entire day (0-100)
SKIP_DAY_PERCENT=15

# Anti-detection: probability of browse-only session with no reactions (0-100)
BROWSE_ONLY_PERCENT=15

# Anti-detection: window time variance in minutes (shifts session windows daily)
WINDOW_VARIANCE_MINUTES=45

# User identity (for admin dashboard tracking)
USER_NAME=YourName
TEAM=default

# Admin server URL (leave empty to disable reporting)
ADMIN_API_URL=
# API key for authenticating reports to admin server
ADMIN_API_KEY=

# ── Auto-Comment (OpenAI) ──────────────────────────────────────
# Enable auto-commenting (default: false — must opt-in)
ENABLE_COMMENTS=false
# Dry run mode: generate and log comments without posting (for testing)
COMMENT_DRY_RUN=false
# OpenAI API key (required for commenting)
OPENAI_API_KEY=
# OpenAI model (gpt-4o-mini for cost, gpt-4o for quality)
OPENAI_MODEL=gpt-4o-mini
# Daily comment target range
DAILY_COMMENT_MIN=3
DAILY_COMMENT_MAX=8
# Min/max posts between comments (anti-detection spacing)
COMMENT_MIN_GAP=3
COMMENT_MAX_GAP=8
